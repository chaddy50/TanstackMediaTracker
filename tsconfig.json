{
  "include": ["**/*.ts", "**/*.tsx"],
  // .claude/worktrees holds linked worktrees inside this checkout. Their sources
  // would otherwise be typechecked here, with "#/*" wrongly resolving to this
  // checkout's src. Listing node_modules is required: naming "exclude" at all
  // replaces the default that would have covered it.
  "exclude": ["node_modules", ".claude"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "baseUrl": ".",
    "paths": {
      "#/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
